# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Site password (HTTP Basic auth). When BOTH vars are set the entire site is
# password-protected. Leave them unset to disable auth (e.g. for local dev).
AUTH_USERNAME=
AUTH_PASSWORD=

# Geoblock is automatic on Vercel (uses x-vercel-ip-country); only requests
# from Nepal (NP) get through. There is nothing to configure here — the block
# is skipped automatically when no country header is present (e.g. localhost).
